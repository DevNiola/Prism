NEXT_PUBLIC_API_URL=https://prism.example.com
REDIS_URL=redis://redis:6379
# Redis authentication password. Set in production via a Kubernetes Secret.
# Leave empty for local development (Redis runs without auth by default).
REDIS_PASSWORD=

# Comma-separated list of allowed CORS origins.
# In production this variable is required; wildcard "*" is rejected.
# Example: https://app.example.com,https://staging.example.com
CORS_ORIGINS=http://localhost:3000

# Optional AI provider. Leave the key empty to disable AI explanations.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS_PER_REQUEST=2048
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=30000
AI_HOURLY_TOKEN_LIMIT=100000
AI_DAILY_TOKEN_LIMIT=1000000
AI_MAX_CONCURRENT=5

# Cache TTL values are in seconds; the deduplication window is milliseconds.
CACHE_DECODE_TTL=86400
CACHE_PROFILE_TTL=3600
DEDUP_WINDOW_MS=10000